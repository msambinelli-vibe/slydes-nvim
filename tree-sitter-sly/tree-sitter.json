{
  "grammars": [
    {
      "name": "sly",
      "camelcase": "Sly",
      "scope": "source.sly",
      "path": ".",
      "file-types": ["sly"],
      "highlights": ["queries/highlights.scm"],
      "injections": ["queries/injections.scm"]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Slydes presentation language",
    "authors": [{ "name": "Slydes contributors" }],
    "links": {
      "repository": "https://github.com/slydes-org/slides-nvim"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
